        "id": "network",
        "label": "Network and ports",
        "focus": [
          "tsside",
          "orca",
          "devports",
          "dind"
        ],
        "note": "One shared netns: Orca on 6768, dynamic preview ports, and the DinD API on loopback only."
      },
      {
        "id": "updates",
        "label": "Updates without rebuild",
        "focus": [
          "upstream",
          "supervisor",
          "orca",
          "agents"
        ],
        "note": "supercronic runs mup at 04:15; Orca and the agent CLIs land on the volume, never in the image."
      },
      {
        "id": "state",
        "label": "Persistence",
        "focus": [
          "orca",
          "home",
          "ws",
          "dind"
        ],
        "note": "orca-home keeps the runtime, pairing state and credentials; workspace keeps the git repositories."
      }
    ]
