  "cards": [
    {
      "dot": "cyan",
      "title": "Layers and access",
      "items": [
        "Desktop pairs with the orca://pair?code=… URL taken from the logs",
        "The Tailscale sidecar owns the netns; orca-server joins via service:tailscale",
        "Debian trixie-slim + Electron libs, AppImage extracted (no FUSE)",
        "The Orca binary lives on the volume — mup upgrades it without a rebuild"
      ]
    },
    {
      "dot": "amber",
      "title": "Ports",
      "items": [
        ":6768 — Orca serve, bound to 0.0.0.0 inside the sidecar netns",
        "Any 0.0.0.0:<port> bind becomes http://orca-dev:<port> on the tailnet",
        ":2375 — DinD API on 127.0.0.1 only, never on the tailnet",
        "No port published on the Docker host"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "Runs as uid=1000 (orca); no --privileged on Orca",
        "No host docker.sock by default — DinD isolated behind profile dind",
        "ORCA_PAIRING_ADDRESS must be a tailnet name/IP, never 0.0.0.0",
        "orca-home holds credentials and pairing state: treat backups as secrets"
      ]
    }
  ]
