# Orca
ORCA_VERSION=1.4.185
ORCA_SHA256=
ORCA_PORT=6768
# IP/hostname Tailscale anunciado no pairing (ex.: 100.x.y.z ou orca-dev)
ORCA_PAIRING_ADDRESS=
PUID=1000
PGID=1000

# Tailscale sidecar
TAILSCALE_VERSION=latest
TAILSCALE_HOSTNAME=orca-dev
TS_AUTHKEY=

# Runtime (mise)
MISE_VERSION=
NODE_VERSION=22
PYTHON_VERSION=3.13
UV_VERSION=latest

# Updates
AUTO_UPDATE_AGENTS=false

# Agents (build-time install flags)
INSTALL_CLAUDE=true
INSTALL_CODEX=true
INSTALL_GEMINI=true
INSTALL_CURSOR=true
INSTALL_OPENCODE=true
INSTALL_GROK=false
INSTALL_HERMES=false
INSTALL_QWEN=false
INSTALL_KIMI=false

# Optional agent channels / pins (empty = tool default / latest when allowed)
CLAUDE_VERSION=
CODEX_VERSION=
GEMINI_VERSION=
CLAUDE_CHANNEL=latest
CODEX_CHANNEL=latest
GEMINI_CHANNEL=latest
CURSOR_CHANNEL=latest
