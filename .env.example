# Orca runtime (installed into persistent volume — NOT baked into image by default)
# Pin a tag (e.g. 1.4.192) or use latest. Headless Orca does not self-update.
ORCA_VERSION=latest
ORCA_SHA256=
ORCA_PORT=6768
# IP/hostname Tailscale advertised in pairing (ex.: 100.x.y.z or orca-dev)
# Do not use 0.0.0.0 / * / :: — official docs forbid advertising wildcards.
ORCA_PAIRING_ADDRESS=
# On boot: download newer Orca into the volume (default false — deliberate upgrades)
AUTO_UPDATE_ORCA=false
# Optional: bake a seed copy into the image at build time (still updatable in volume)
ORCA_SEED_IN_IMAGE=false
PUID=1000
PGID=1000

# Tailscale sidecar
TAILSCALE_VERSION=latest
TAILSCALE_HOSTNAME=orca-dev
TS_AUTHKEY=

# Runtime (mise)
MISE_VERSION=
NODE_VERSION=22
PYTHON_VERSION=3.13
UV_VERSION=latest

# Updates
AUTO_UPDATE_AGENTS=false

# Agents (build-time install flags)
INSTALL_CLAUDE=true
INSTALL_CODEX=true
INSTALL_GEMINI=true
INSTALL_CURSOR=true
INSTALL_OPENCODE=true
INSTALL_GROK=false
INSTALL_HERMES=false
INSTALL_QWEN=false
INSTALL_KIMI=false

# Optional agent channels / pins (empty = tool default)
CLAUDE_VERSION=
CODEX_VERSION=
GEMINI_VERSION=
CLAUDE_CHANNEL=latest
CODEX_CHANNEL=latest
GEMINI_CHANNEL=latest
CURSOR_CHANNEL=latest
