# Orca runtime (installed into persistent volume — NOT baked into image by default)
# Pin a tag (e.g. 1.4.192) or use latest. Headless Orca does not self-update.
ORCA_VERSION=latest
ORCA_SHA256=
ORCA_PORT=6768
# Tailscale IP/hostname advertised in pairing (e.g. 100.x.y.z or orca-dev)
# Do not use 0.0.0.0 / * / :: — official docs forbid advertising wildcards.
ORCA_PAIRING_ADDRESS=
# Optional: bake a seed copy into the image at build time (still updatable in volume)
ORCA_SEED_IN_IMAGE=false
PUID=1000
PGID=1000

# Git (installed in image; identity applied on every boot into ~/.gitconfig on volume)
GIT_USER_NAME=Andre Avila
GIT_USER_EMAIL=andre.alexandre.avila@gmail.com
GIT_INIT_DEFAULT_BRANCH=main

# --- mup schedule (100% inside the container — nothing on the host) ---
# supercronic runs next to orca; mup updates tools + Orca + agents without rebuild.
MUP_SCHEDULE=true
# Cron expression (container local time). Default = 04:15 daily.
MUP_CRON="15 4 * * *"
# Run mup once when the container starts (can delay first ready)
MUP_ON_BOOT=false
# Timezone for the schedule (example Brazil)
TZ=America/Sao_Paulo
# Legacy aliases (still honored by supervise):
AUTO_UPDATE_ALL=false
AUTO_UPDATE_ORCA=false
AUTO_UPDATE_AGENTS=false

# Tailscale sidecar
TAILSCALE_VERSION=latest
TAILSCALE_HOSTNAME=orca-dev
TS_AUTHKEY=

# Runtime (mise)
MISE_VERSION=
NODE_VERSION=22
PYTHON_VERSION=3.13
UV_VERSION=latest

# mup component toggles (when running `mup` / mise run mup)
# MUP_TOOLS=true
# MUP_ORCA=true
# MUP_AGENTS=true

# Agents (build-time install flags + runtime mup/update-agents)
INSTALL_CLAUDE=true
INSTALL_CODEX=true
INSTALL_GEMINI=true
INSTALL_CURSOR=true
INSTALL_OPENCODE=true
INSTALL_GROK=false
INSTALL_HERMES=false
INSTALL_QWEN=false
INSTALL_KIMI=false

# Optional agent channels / pins (empty = latest)
CLAUDE_VERSION=
CODEX_VERSION=
GEMINI_VERSION=
CLAUDE_CHANNEL=latest
CODEX_CHANNEL=latest
GEMINI_CHANNEL=latest
CURSOR_CHANNEL=latest
CURSOR_INSTALL_URL=
# Official OpenCode installer (default used by scripts if empty):
OPENCODE_INSTALL_URL=https://opencode.ai/install
